	)
	(text "each connector needs both bulk (10uF) caps and high-frequency caps (100n)\nto ensure that quick transients don't cause brownout on board"
		(exclude_from_sim no)
		(at 97.282 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "08c1e28b-3d74-4a8f-b4f3-a3669cf678fe")
	)
	(text "Power Budget (Peak, during ranging):\nuC: STM32G474 -> 150mA\nToF Imagers: 130mA @ 3v3 * 3\nMagetometer: <10mA @ 3v3\n\nTotal = 550 mA\n\nPeak power dissipated by LDO: (5v-3v3) * 550mA = 0.94W (too high) \nPeak power dissipated by Buck: 3v3 * 550mA * (1 / (92%) - 1) =  150mW (acceptable)\nCurrent @ 5V VBUS: (3v3 * 550mA) / (5v * 92%) = 394mA (works under standard usb blocks)"
		(exclude_from_sim no)
		(at 43.434 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a9b90e3-b652-4c9e-8139-9a6aef291e29")
	)
	(text "Microcontroller"
		(exclude_from_sim no)
		(at 191.262 14.478 0)
